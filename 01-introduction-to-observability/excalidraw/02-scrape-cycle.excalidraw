      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Because up is written on every cycle, a target going down is a data point,",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Because up is written on every cycle, a target going down is a data point,",
      "lineHeight": 1.25,
      "baseline": 15
    },
